# Rust build artifacts
/target/
apps/desktop/src-tauri/target/
**/*.rs.bk

# Node.js dependencies and build outputs
node_modules/
build/
.npm/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android build outputs & caches
.gradle/
**/build/
**/app/build/
**/captures/
.externalNativeBuild/

# Model weights, cache, and shard binaries (downloaded dynamically)
*.gguf
*.bin
*.safetensors
*.onnx
*.shard
*.part
models/
**/models/
model_cache/
**/model_cache/

# TLS certificates & secrets
*.pem
*.key
*.cert
*.crt
.env
.env.*
!.env.example

# OS and IDE temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
.cursor/

# Peer-local SQLite (never commit user chat databases)
*.db-wal
*.db-shm
**/storage/database/community.db

# Packaging secrets (never commit)
*.jks
*.keystore

# Built installers (hashes live in docs/release-builds.md)
/release/*.AppImage
/release/*.exe
/release/*.msi
/release/*.apk
/release/*.aab
/release/*.deb
/release/*.rpm
/release/*.sha256

# Tauri ACL schemas regenerated on each host build
apps/desktop/src-tauri/gen/schemas/

